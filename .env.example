# Copia este archivo a .env y completa los valores. Nunca subas .env al repo.

# Puerto del servidor HTTP
PORT=3000

# Archivo de la base de datos SQLite (se crea solo)
DB_PATH=data/gobernanza.db

# Código que necesita una persona para crear una cuenta de agente.
# Sin este valor no se pueden crear cuentas nuevas.
CODIGO_REGISTRO=cambia-este-codigo-largo

# Clave de la API de Anthropic. Si está vacía, la app usa reglas locales
# (sin enviar nada a un proveedor externo).
ANTHROPIC_API_KEY=

# Modelo que se usa cuando hay ANTHROPIC_API_KEY
MODELO_IA=claude-haiku-5-5

# Días que se conservan las solicitudes antes de la purga automática
RETENCION_DIAS=365
